{
  "name": "gospel-of-john-city",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "The Gospel of John rendered as a city — 2D map + 3D ancient city",
  "scripts": {
    "verify": "node scripts/verify_parity.mjs",
    "bundle": "esbuild src/main.js --bundle --format=iife --minify --target=es2019 --outfile=build/city3d-three.bundle.js",
    "build": "npm run verify && npm run bundle && python3 scripts/build.py",
    "watch": "esbuild src/main.js --bundle --format=iife --target=es2019 --outfile=build/city3d-three.bundle.js --watch"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1",
    "three": "^0.185.1"
  }
}
